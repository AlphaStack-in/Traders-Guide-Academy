# Copy this file to .env and fill in real values from your Supabase project settings.
# Supabase Dashboard > Project Settings > API and > Database.

# --- Prisma (Database > Connection string) ---
# Pooled connection (via Supavisor/pgbouncer) - used at runtime
DATABASE_URL="postgresql://postgres.xxxxxxxx:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection - used by `prisma migrate` only
DIRECT_URL="postgresql://postgres.xxxxxxxx:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase client (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Server-only - never expose to the browser, never commit
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Admin authorization ---
# Comma-separated list of email addresses that are permitted to access the
# admin area and perform admin Server Actions.  This is server-only (no
# NEXT_PUBLIC_ prefix) and never reaches the browser.
# If this variable is not set, ALL admin access is denied (fail-closed).
# Example: ADMIN_EMAILS="alice@example.com,bob@example.com"
ADMIN_EMAILS="your-admin@example.com"

# --- Telegram notifications (optional) ---
# Create a bot via @BotFather in Telegram to get the token; add the bot to
# your group and call https://api.telegram.org/bot<token>/getUpdates to find
# the chat ID. New signals and trade closes are silently skipped if unset.
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-group-chat-id"

# --- Broker connect (Dhan) ---
# 32-byte key (base64) for AES-256-GCM encryption of stored Dhan access
# tokens. Generate one: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
BROKER_TOKEN_ENC_KEY="your-32-byte-base64-key"
