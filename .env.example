# Copy this file to .env and fill in real values.

# --- Prisma (Database > Connection string) ---
# Pooled connection (e.g. Neon's "-pooler" host) - used at runtime
DATABASE_URL="postgresql://user:YOUR_DB_PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct/unpooled connection - used by `prisma migrate` only
DIRECT_URL="postgresql://user:YOUR_DB_PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# --- Admin login (single hardcoded admin — see src/lib/admin-rbac.ts) ---
ADMIN_EMAIL="your-admin@example.com"
# Generate with: npm run hash-password -- 'your-chosen-password'
ADMIN_PASSWORD_HASH="scrypt-hash-generated-via-npm-run-hash-password"

# --- Session signing (admin + subscriber cookies) ---
# 32-byte random secret. Generate one:
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SESSION_SECRET="your-session-secret"

# --- Telegram notifications (optional) ---
# Create a bot via @BotFather in Telegram to get the token; add the bot to
# your group and call https://api.telegram.org/bot<token>/getUpdates to find
# the chat ID. New signals and trade closes are silently skipped if unset.
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-group-chat-id"

# --- Broker connect (Dhan) ---
# 32-byte key (base64) for AES-256-GCM encryption of stored Dhan access
# tokens. Generate one: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
BROKER_TOKEN_ENC_KEY="your-32-byte-base64-key"

# --- Cron authorization ---
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` on triggered
# requests. Fails closed if this isn't set. Generate one:
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
CRON_SECRET="your-cron-secret"

# --- Email (Resend) ---
# API key from https://resend.com/api-keys. When unset, emails are simulated
# (logged to console) — useful for local dev.
RESEND_API_KEY=""

# Optional: override the From address for outgoing emails. Must be a verified
# domain in Resend. Falls back to "SiteName <noreply@tga-placeholder.app>".
EMAIL_FROM_ADDRESS=""

# --- Public base URL (required for digest emails) ---
# The production URL of your app. Used to build unsubscribe links in digest
# emails. If unset, links will point to http://localhost:3000.
NEXT_PUBLIC_BASE_URL="https://your-production-domain.com"

# --- Digest unsubscribe ---
# HMAC secret for signing unsubscribe tokens in weekly digest emails.
# Generate one: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
DIGEST_UNSUBSCRIBE_SECRET="your-unsubscribe-secret"
