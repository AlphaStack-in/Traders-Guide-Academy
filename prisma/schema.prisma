// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Signal {
  id             String       @id @default(uuid())
  strike         Int
  optionType     OptionType
  entryPrice     Float
  stopLoss       Float
  targets        Float[]
  priceAtSignal  Float
  sellPrice      Float?
  status         SignalStatus @default(OPEN)
  pnlPercent     Float?
  signalTime     DateTime     @default(now())
  closedTime     DateTime?
  rawMessage     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  adminNote      String?
  instrument     Instrument?
  // Options expiry date, admin-set at signal creation — needed to resolve
  // this signal to an exact tradable Dhan contract (see broker connect
  // feature). Nullable since older signals predate this field.
  expiry         DateTime?
  // Set by the Manage Signals edit form so the realtime listener can tell
  // "admin corrected a field" apart from a genuine new/closed signal and
  // skip the sound alert for it (still refreshes page content either way).
  silentUpdateAt DateTime?

  // Snapshotted lot size from DhanInstrument at signal creation time --
  // used by the weekly digest to compute rupee P&L without needing the
  // ephemeral DhanInstrument cache (which purges expired contracts daily).
  lotSize        Int?

  // Platform enhancement fields
  chartImageUrl  String?
  entryLow       Float?
  entryHigh      Float?
  target1        Float?
  target2        Float?
  contextTags    String[]     @default([])
  confidence     String?      @default("HIGH")
  parserName     String?      @default("SIGNALFLOW")
  parserVersion  String?      @default("1.0.0")

  @@index([signalTime])
  @@index([status])
}

model Subscriber {
  id                    String                 @id @default(uuid())
  name                  String
  phone                 String
  email                 String?
  plan                  SubscriberPlan         @default(PREMIUM)
  createdAt             DateTime               @default(now())
  batchNumber           Int?
  couponCode            String?
  currentBroker         String?
  referralStatus        ReferralStatus         @default(NOT_JOINED)
  invitedAt             DateTime?
  invitedBy             String?
  invitationToken       String?                @unique
  // Scrypt hash of the subscriber's login password (see src/lib/password.ts).
  // Set at self-service registration (src/app/register/actions.ts), which
  // also logs the subscriber in immediately. An admin can still set/reset it
  // directly from the admin panel (e.g. for a subscriber who forgets theirs)
  // — there is still no self-service password-reset-by-email flow.
  passwordHash          String?
  // Whether the subscriber has opted out of the weekly performance digest
  // email. Defaults to false (opted in). Set to true via the HMAC-signed
  // unsubscribe link in the digest email footer.
  emailDigestOptOut     Boolean                @default(false)
  brokerConnection      BrokerConnection?
  orderAuditLogs        OrderAuditLog[]
  goodwillOrderRequests GoodwillOrderRequest[]
  rewardTransactions    RewardTransaction[]
  socialPromotionEvents SocialPromotionEvent[]
  digestSendLogs        DigestSendLog[]
}

enum ReferralStatus {
  JOINED
  INVITED
  NOT_JOINED
  REGISTERED
  PAYMENT_PENDING
  SUCCESSFUL
  REWARD_CREDITED
  REDEEMED
}

// One Dhan account per subscriber. connectMethod is PERSONAL_TOKEN today (a
// pasted self-generated Dhan access token — no partner approval needed);
// PARTNER_OAUTH is reserved for once SignalFlow's Dhan partner_id/secret arrive, at
// which point only the connect flow changes, not this model or anything
// downstream (order placement, square-off).
model BrokerConnection {
  id             String                 @id @default(uuid())
  subscriberId   String                 @unique
  subscriber     Subscriber             @relation(fields: [subscriberId], references: [id])
  dhanClientId   String
  dhanClientName String?
  connectMethod  BrokerConnectMethod    @default(PERSONAL_TOKEN)
  // AES-256-GCM encrypted Dhan access token (see src/lib/broker/crypto.ts).
  accessTokenEnc String
  tokenExpiresAt DateTime
  status         BrokerConnectionStatus @default(ACTIVE)
  lastError      String?
  // Set on each successful daily auto-renew (see /v2/RenewToken cron) — null
  // if this connection has never been renewed (still on its original token).
  lastRenewedAt  DateTime?
  // Whether we've successfully called Dhan's /v2/ip/setIP for this
  // subscriber yet (one-time per subscriber; Dhan only allows changing it
  // once every 7 days after that, so we don't retry this once it's true).
  ipWhitelisted  Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

enum BrokerConnectMethod {
  PERSONAL_TOKEN
  PARTNER_OAUTH
}

enum BrokerConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// Daily-refreshed cache of Dhan's scrip master CSV, filtered to the option
// contracts we care about — resolves a Signal (underlying + expiry + strike
// + optionType) to the exact Dhan securityId/exchangeSegment an order needs.
// Refreshed wholesale each morning (see the instrument-sync job) rather than
// fetched live per order, since Dhan's master file is a daily publish, not
// intraday.
model DhanInstrument {
  id              String     @id @default(uuid())
  underlying      Instrument
  expiry          DateTime
  strike          Int
  optionType      OptionType
  securityId      String
  exchangeSegment String
  tradingSymbol   String
  // Exchange lot size for this contract (e.g. 75) — subscribers enter a
  // number of lots, Dhan's order API wants raw quantity, so orders multiply
  // the entered lot count by this.
  lotSize         Int
  updatedAt       DateTime   @updatedAt

  @@unique([underlying, expiry, strike, optionType])
  @@index([updatedAt])
}

// One row per Place Order attempt (success or failure) — the audit trail
// admins can see per subscriber, and what powers the inline order form's
// success/error message.
model OrderAuditLog {
  id                 String           @id @default(uuid())
  // Not a DB foreign key, same reasoning as AdminUpdate.signalId — this is
  // an independent audit trail, so instrument/strike/optionType are
  // snapshotted below rather than joined, and stay readable even if the
  // signal is later deleted.
  signalId           String
  instrument         Instrument?
  strike             Int
  optionType         OptionType
  subscriberId       String
  subscriber         Subscriber       @relation(fields: [subscriberId], references: [id])
  brokerConnectionId String
  lotSize            Int
  productType        DhanProductType  @default(INTRADAY)
  dhanOrderId        String?
  status             OrderAuditStatus
  dhanResponse       Json?
  errorMessage       String?
  placedAt           DateTime         @default(now())

  @@index([subscriberId])
  @@index([signalId])
}

enum DhanProductType {
  INTRADAY
  MARGIN
}

enum OrderAuditStatus {
  PLACED
  REJECTED
  ERROR
}

// One row per Goodwill "Place Order" request. GIGAPRO (Goodwill's broker)
// has no order-placement API integration yet, so this is only a request log
// for the ops team to action manually per the OTP-confirmation-first
// rollout plan — not a real order audit trail like OrderAuditLog above,
// which is Dhan-specific (real order IDs, broker responses).
model GoodwillOrderRequest {
  id           String              @id @default(uuid())
  // Not a DB foreign key, same reasoning as OrderAuditLog.signalId above.
  signalId     String
  instrument   Instrument?
  strike       Int
  optionType   OptionType
  subscriberId String
  subscriber   Subscriber          @relation(fields: [subscriberId], references: [id])
  lotSize      Int
  productType  GoodwillProductType @default(INTRADAY)
  requestedAt  DateTime            @default(now())

  @@index([subscriberId])
  @@index([signalId])
}

enum GoodwillProductType {
  INTRADAY
  MARGIN
}

model Referral {
  id            String   @id @default(uuid())
  referrerName  String
  referrerPhone String
  referredName  String
  referredPhone String
  createdAt     DateTime @default(now())

  @@index([referrerPhone])
}

// Append-only log of admin updates posted to users, for the notification
// bell — Signal.adminNote only holds the current note, this is the history.
model AdminUpdate {
  id         String      @id @default(uuid())
  signalId   String
  strike     Int
  optionType OptionType
  message    String
  createdAt  DateTime    @default(now())
  instrument Instrument?

  @@index([createdAt])
}

model ContactMessage {
  id        String               @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String
  status    ContactMessageStatus @default(NEW)
  replyText String?
  repliedAt DateTime?
  createdAt DateTime             @default(now())

  @@index([status])
  @@index([createdAt])
}

model Coupon {
  id            String             @id
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Int
  active        Boolean            @default(true)
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
}

enum OptionType {
  CE
  PE
}

enum Instrument {
  NIFTY
  SENSEX
  MIDCAP_NIFTY
  BANK_NIFTY
}

enum SignalStatus {
  OPEN
  TARGET_HIT
  SL_HIT
  CLOSED_MANUAL
  EXPIRED
}

enum SubscriberPlan {
  PREMIUM
}

enum ContactMessageStatus {
  NEW
  REPLIED
}

enum CouponDiscountType {
  PERCENT
  FLAT
}

enum RewardTransactionType {
  REFERRAL_REWARD
  SOCIAL_PROMOTION
  SUBSCRIPTION_REDEMPTION
  ADJUSTMENT
}

enum RewardTransactionStatus {
  CREDITED
  PENDING
  REDEEMED
}

model RewardTransaction {
  id           String                  @id @default(uuid())
  subscriberId String
  subscriber   Subscriber              @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  type         RewardTransactionType
  amount       Float
  status       RewardTransactionStatus @default(CREDITED)
  description  String
  referenceId  String?
  createdAt    DateTime                @default(now())

  @@index([subscriberId])
  @@index([type])
}

model SocialPromotionEvent {
  id           String     @id @default(uuid())
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  platform     String
  shareDate    String     // Format: YYYY-MM-DD (IST)
  rewardAmount Float      @default(10)
  createdAt    DateTime   @default(now())

  @@unique([subscriberId, shareDate])
  @@index([subscriberId])
}

// Dedup + audit log for weekly performance digest emails. One row per
// subscriber per week -- the unique constraint on (subscriberId, weekStartDate)
// prevents duplicate sends if the cron is retried or double-invoked.
model DigestSendLog {
  id              String     @id @default(uuid())
  subscriberId    String
  subscriber      Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  subscriberEmail String
  weekStartDate   DateTime
  sentAt          DateTime   @default(now())
  signalCount     Int
  winRate         Float
  totalPnlPoints  Float
  totalPnlRupees  Float?

  @@unique([subscriberId, weekStartDate])
  @@index([weekStartDate])
}

model NewsAlert {
  id                  String   @id @default(uuid())
  title               String
  category            String   @default("Market")
  severity            String   @default("INFO")
  summary             String
  content             String
  impact              String?
  affectedInstruments String[] @default([])
  source              String?
  sourceUrl           String?
  publishedAt         DateTime @default(now())
  expiresAt           DateTime?
  isBreaking          Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([publishedAt])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Admin RBAC — database-backed admin users and access levels.
// Authorization is performed by src/lib/admin-rbac.ts which joins the
// Supabase Auth session (supabaseUserId) to this table.
// Never trust user_metadata or client-provided email for authorization.
// ---------------------------------------------------------------------------

enum AdminAccessLevel {
  SUPER_ADMIN
  ADMIN
  SIGNAL_MANAGER
  SUPPORT
  VIEWER
}

// One row per authorized admin.  supabaseUserId is the permanent auth identity
// (Supabase Auth user.id) once bound.  email is the onboarding / binding key
// only — used to create pending admins and bind UUID on first Google login.
// After binding, authorization uses supabaseUserId (never email alone).
model AdminUser {
  id             String           @id @default(uuid())
  supabaseUserId String?          @unique // null until first successful Google login
  email          String           @unique // normalized lowercase; onboarding key
  accessLevel    AdminAccessLevel @default(VIEWER)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  auditChangesBy  AdminUserAuditLog[] @relation("ChangedBy")
  auditChangesFor AdminUserAuditLog[] @relation("ChangedFor")

  @@index([supabaseUserId])
  @@index([isActive])
}

// Append-only audit trail for admin access-level and activation changes.
model AdminUserAuditLog {
  id            String    @id @default(uuid())
  changedById   String
  changedBy     AdminUser @relation("ChangedBy", fields: [changedById], references: [id])
  targetAdminId String
  targetAdmin   AdminUser @relation("ChangedFor", fields: [targetAdminId], references: [id])
  action        String    // "SET_ACCESS_LEVEL" | "ACTIVATE" | "DEACTIVATE" | "CREATE"
  previousValue String?
  newValue      String?
  createdAt     DateTime  @default(now())

  @@index([changedById])
  @@index([targetAdminId])
  @@index([createdAt])
}
