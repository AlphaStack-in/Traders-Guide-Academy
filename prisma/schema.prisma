// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Signal {
  id             String       @id @default(uuid())
  strike         Int
  optionType     OptionType
  entryPrice     Float
  stopLoss       Float
  targets        Float[]
  priceAtSignal  Float
  sellPrice      Float?
  status         SignalStatus @default(OPEN)
  pnlPercent     Float?
  signalTime     DateTime     @default(now())
  closedTime     DateTime?
  rawMessage     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  adminNote      String?
  instrument     Instrument?
  // Actual stock ticker when instrument = STOCK (e.g. "RELIANCE") — the
  // `instrument` enum only tells us the signal is *some* individual stock,
  // not which one, so the real ticker lives here. Null for every
  // index/commodity signal. Also used to seed the Stock Symbol combobox
  // with "already used" suggestions.
  stockSymbol    String?
  // Options expiry date, admin-set at signal creation — needed to resolve
  // this signal to an exact tradable Dhan contract (see broker connect
  // feature). Nullable since older signals predate this field.
  expiry         DateTime?
  // Set by the Manage Signals edit form so the realtime listener can tell
  // "admin corrected a field" apart from a genuine new/closed signal and
  // skip the sound alert for it (still refreshes page content either way).
  silentUpdateAt DateTime?

  // Snapshotted lot size from DhanInstrument at signal creation time --
  // used by the weekly digest to compute rupee P&L without needing the
  // ephemeral DhanInstrument cache (which purges expired contracts daily).
  lotSize Int?

  // Platform enhancement fields
  chartImageUrl String?
  entryLow      Float?
  entryHigh     Float?
  target1       Float?
  target2       Float?
  contextTags   String[] @default([])
  confidence    String?  @default("HIGH")
  parserName    String?  @default("SIGNALFLOW")
  parserVersion String?  @default("1.0.0")

  @@index([signalTime])
  @@index([status])
}

model Subscriber {
  id                    String                 @id @default(uuid())
  name                  String
  phone                 String
  // Normalize with normalizeEmail() (src/lib/utils.ts) before every write —
  // the @unique constraint below is a plain case-sensitive DB unique index,
  // so two accounts could still collide as "Foo@x.com" vs "foo@x.com" if a
  // caller stores a non-normalized value directly.
  email                 String?                @unique
  plan                  SubscriberPlan         @default(PREMIUM)
  createdAt             DateTime               @default(now())
  // Which pricing tier the subscriber registered under (Monthly/Quarterly/
  // Yearly — see clientConfig.pricingPlans for current prices). Nullable
  // because subscribers created before this field existed have no value —
  // don't assume MONTHLY for them, show a generic view instead (see
  // payment-details-card.tsx).
  billingCycle          BillingCycle?
  batchNumber           Int?
  couponCode            String?
  currentBroker         String?
  referralStatus        ReferralStatus         @default(NOT_JOINED)
  invitedAt             DateTime?
  invitedBy             String?
  invitationToken       String?                @unique
  // Scrypt hash of the subscriber's login password (see src/lib/password.ts).
  // Set at self-service registration (src/app/register/actions.ts), which
  // also logs the subscriber in immediately. An admin can still set/reset it
  // directly from the admin panel (e.g. for a subscriber who forgets theirs)
  // — there is still no self-service password-reset-by-email flow.
  passwordHash          String?
  // Google account id (the OAuth "sub" claim), set the first time a
  // subscriber signs in with Google and their verified Google email
  // matches an existing account (see src/app/api/auth/google/callback).
  // Google sign-in only ever authenticates an *existing* subscriber this
  // way — it never creates one, since registration also needs a phone
  // number Google doesn't provide (see src/app/register/actions.ts).
  googleId              String?                @unique
  // Whether the subscriber has opted out of the weekly performance digest
  // email. Defaults to false (opted in). Set to true via the HMAC-signed
  // unsubscribe link in the digest email footer, or from the subscriber's
  // own Settings page (src/app/account/settings).
  emailDigestOptOut     Boolean                @default(false)
  // Whether this subscriber wants instant notification-bell alerts (Ably
  // push for admin updates / signal events). Defaults to true (opted in).
  // Toggled from the subscriber's own Settings page.
  notificationsEnabled  Boolean                @default(true)
  brokerConnection      BrokerConnection?
  orderAuditLogs        OrderAuditLog[]
  goodwillOrderRequests GoodwillOrderRequest[]
  rewardTransactions    RewardTransaction[]
  socialPromotionEvents SocialPromotionEvent[]
  digestSendLogs        DigestSendLog[]
  subscriptions         Subscription[]
  payments              Payment[]
}

enum ReferralStatus {
  JOINED
  INVITED
  NOT_JOINED
  REGISTERED
  PAYMENT_PENDING
  SUCCESSFUL
  REWARD_CREDITED
  REDEEMED
}

// One Dhan account per subscriber. connectMethod is PERSONAL_TOKEN today (a
// pasted self-generated Dhan access token — no partner approval needed);
// PARTNER_OAUTH is reserved for once SignalFlow's Dhan partner_id/secret arrive, at
// which point only the connect flow changes, not this model or anything
// downstream (order placement, square-off).
model BrokerConnection {
  id             String                 @id @default(uuid())
  subscriberId   String                 @unique
  subscriber     Subscriber             @relation(fields: [subscriberId], references: [id])
  dhanClientId   String
  dhanClientName String?
  connectMethod  BrokerConnectMethod    @default(PERSONAL_TOKEN)
  // AES-256-GCM encrypted Dhan access token (see src/lib/broker/crypto.ts).
  accessTokenEnc String
  tokenExpiresAt DateTime
  status         BrokerConnectionStatus @default(ACTIVE)
  lastError      String?
  // Set on each successful daily auto-renew (see /v2/RenewToken cron) — null
  // if this connection has never been renewed (still on its original token).
  lastRenewedAt  DateTime?
  // Whether we've successfully called Dhan's /v2/ip/setIP for this
  // subscriber yet (one-time per subscriber; Dhan only allows changing it
  // once every 7 days after that, so we don't retry this once it's true).
  ipWhitelisted  Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

enum BrokerConnectMethod {
  PERSONAL_TOKEN
  PARTNER_OAUTH
}

enum BrokerConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// Daily-refreshed cache of Dhan's scrip master CSV, filtered to the option
// contracts we care about — resolves a Signal (underlying + expiry + strike
// + optionType) to the exact Dhan securityId/exchangeSegment an order needs.
// Refreshed wholesale each morning (see the instrument-sync job) rather than
// fetched live per order, since Dhan's master file is a daily publish, not
// intraday.
model DhanInstrument {
  id              String     @id @default(uuid())
  underlying      Instrument
  expiry          DateTime
  strike          Int
  optionType      OptionType
  securityId      String
  exchangeSegment String
  tradingSymbol   String
  // Exchange lot size for this contract (e.g. 75) — subscribers enter a
  // number of lots, Dhan's order API wants raw quantity, so orders multiply
  // the entered lot count by this.
  lotSize         Int
  updatedAt       DateTime   @updatedAt

  @@unique([underlying, expiry, strike, optionType])
  @@index([updatedAt])
}

// One row per Place Order attempt (success or failure) — the audit trail
// admins can see per subscriber, and what powers the inline order form's
// success/error message.
model OrderAuditLog {
  id                 String           @id @default(uuid())
  // Not a DB foreign key, same reasoning as AdminUpdate.signalId — this is
  // an independent audit trail, so instrument/strike/optionType are
  // snapshotted below rather than joined, and stay readable even if the
  // signal is later deleted.
  signalId           String
  instrument         Instrument?
  strike             Int
  optionType         OptionType
  subscriberId       String
  subscriber         Subscriber       @relation(fields: [subscriberId], references: [id])
  brokerConnectionId String
  lotSize            Int
  productType        DhanProductType  @default(INTRADAY)
  dhanOrderId        String?
  status             OrderAuditStatus
  dhanResponse       Json?
  errorMessage       String?
  placedAt           DateTime         @default(now())

  @@index([subscriberId])
  @@index([signalId])
}

enum DhanProductType {
  INTRADAY
  MARGIN
}

enum OrderAuditStatus {
  PLACED
  REJECTED
  ERROR
}

// One row per Goodwill "Place Order" request. GIGAPRO (Goodwill's broker)
// has no order-placement API integration yet, so this is only a request log
// for the ops team to action manually per the OTP-confirmation-first
// rollout plan — not a real order audit trail like OrderAuditLog above,
// which is Dhan-specific (real order IDs, broker responses).
model GoodwillOrderRequest {
  id           String              @id @default(uuid())
  // Not a DB foreign key, same reasoning as OrderAuditLog.signalId above.
  signalId     String
  instrument   Instrument?
  strike       Int
  optionType   OptionType
  subscriberId String
  subscriber   Subscriber          @relation(fields: [subscriberId], references: [id])
  lotSize      Int
  productType  GoodwillProductType @default(INTRADAY)
  requestedAt  DateTime            @default(now())

  @@index([subscriberId])
  @@index([signalId])
}

enum GoodwillProductType {
  INTRADAY
  MARGIN
}

model Referral {
  id            String   @id @default(uuid())
  referrerName  String
  referrerPhone String
  referredName  String
  referredPhone String
  createdAt     DateTime @default(now())

  @@index([referrerPhone])
}

// Append-only log of admin updates posted to users, for the notification
// bell — Signal.adminNote only holds the current note, this is the history.
model AdminUpdate {
  id         String      @id @default(uuid())
  // Null when this is a general broadcast update posted independent of any
  // specific signal (e.g. admin has something to tell subscribers even
  // though no trade is currently ongoing) — see postGeneralAdminUpdate in
  // src/app/admin/(protected)/signals/actions.ts. Non-null rows keep their
  // original per-signal meaning (new signal, admin note, target hit, etc).
  signalId   String?
  strike     Int?
  optionType OptionType?
  message    String
  createdAt  DateTime    @default(now())
  instrument Instrument?

  @@index([createdAt])
}

model ContactMessage {
  id        String               @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String
  status    ContactMessageStatus @default(NEW)
  replyText String?
  repliedAt DateTime?
  createdAt DateTime             @default(now())

  @@index([status])
  @@index([createdAt])
}

model Coupon {
  id            String             @id
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Int
  active        Boolean            @default(true)
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
}

enum OptionType {
  CE
  PE
}

enum Instrument {
  NIFTY
  SENSEX
  MIDCAP_NIFTY
  BANK_NIFTY
  // A single individual-stock F&O trade (e.g. RELIANCE, TCS) — the actual
  // ticker is not encodable here (this enum only names the four tradable
  // indices), so it's stored separately in Signal.stockSymbol. Broker order
  // placement doesn't resolve STOCK signals yet — the DhanInstrument cache
  // only syncs index (OPTIDX) contracts, not individual-stock (OPTSTK) ones.
  STOCK
}

enum SignalStatus {
  OPEN
  TARGET_HIT
  SL_HIT
  CLOSED_MANUAL
  EXPIRED
}

enum SubscriberPlan {
  PREMIUM
}

// Billing duration a subscriber picked at registration — replaces the old
// single dated-batch pricing model (one fixed price, one start/end date)
// with 3 recurring-duration tiers. See clientConfig.pricingPlans.
enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ContactMessageStatus {
  NEW
  REPLIED
}

enum CouponDiscountType {
  PERCENT
  FLAT
}

enum RewardTransactionType {
  REFERRAL_REWARD
  SOCIAL_PROMOTION
  SUBSCRIPTION_REDEMPTION
  ADJUSTMENT
}

enum RewardTransactionStatus {
  CREDITED
  PENDING
  REDEEMED
}

model RewardTransaction {
  id           String                  @id @default(uuid())
  subscriberId String
  subscriber   Subscriber              @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  type         RewardTransactionType
  amount       Float
  status       RewardTransactionStatus @default(CREDITED)
  description  String
  referenceId  String?
  createdAt    DateTime                @default(now())

  @@index([subscriberId])
  @@index([type])
}

model SocialPromotionEvent {
  id           String     @id @default(uuid())
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  platform     String
  shareDate    String // Format: YYYY-MM-DD (IST)
  rewardAmount Float      @default(10)
  createdAt    DateTime   @default(now())

  @@unique([subscriberId, shareDate])
  @@index([subscriberId])
}

// Dedup + audit log for weekly performance digest emails. One row per
// subscriber per week -- the unique constraint on (subscriberId, weekStartDate)
// prevents duplicate sends if the cron is retried or double-invoked.
model DigestSendLog {
  id              String     @id @default(uuid())
  subscriberId    String
  subscriber      Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  subscriberEmail String
  weekStartDate   DateTime
  sentAt          DateTime   @default(now())
  signalCount     Int
  winRate         Float
  totalPnlPoints  Float
  totalPnlRupees  Float?

  @@unique([subscriberId, weekStartDate])
  @@index([weekStartDate])
}

model NewsAlert {
  id                  String    @id @default(uuid())
  title               String
  category            String    @default("Market")
  severity            String    @default("INFO")
  summary             String
  content             String
  impact              String?
  affectedInstruments String[]  @default([])
  source              String?
  sourceUrl           String?
  publishedAt         DateTime  @default(now())
  expiresAt           DateTime?
  isBreaking          Boolean   @default(false)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([publishedAt])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Admin RBAC — database-backed admin users and access levels.
// Authorization is performed by src/lib/admin-rbac.ts which joins the
// Supabase Auth session (supabaseUserId) to this table.
// Never trust user_metadata or client-provided email for authorization.
// ---------------------------------------------------------------------------

enum AdminAccessLevel {
  SUPER_ADMIN
  ADMIN
  SIGNAL_MANAGER
  SUPPORT
  VIEWER
}

// One row per authorized admin.  supabaseUserId is the permanent auth identity
// (Supabase Auth user.id) once bound.  email is the onboarding / binding key
// only — used to create pending admins and bind UUID on first Google login.
// After binding, authorization uses supabaseUserId (never email alone).
model AdminUser {
  id             String           @id @default(uuid())
  supabaseUserId String?          @unique // null until first successful Google login
  email          String           @unique // normalized lowercase; onboarding key
  accessLevel    AdminAccessLevel @default(VIEWER)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  auditChangesBy  AdminUserAuditLog[] @relation("ChangedBy")
  auditChangesFor AdminUserAuditLog[] @relation("ChangedFor")

  @@index([supabaseUserId])
  @@index([isActive])
}

// Append-only audit trail for admin access-level and activation changes.
model AdminUserAuditLog {
  id            String    @id @default(uuid())
  changedById   String
  changedBy     AdminUser @relation("ChangedBy", fields: [changedById], references: [id])
  targetAdminId String
  targetAdmin   AdminUser @relation("ChangedFor", fields: [targetAdminId], references: [id])
  action        String // "SET_ACCESS_LEVEL" | "ACTIVATE" | "DEACTIVATE" | "CREATE"
  previousValue String?
  newValue      String?
  createdAt     DateTime  @default(now())

  @@index([changedById])
  @@index([targetAdminId])
  @@index([createdAt])
}

// --- Self-service billing (Cashfree) ---------------------------------------
// Added when the manual "pay via UPI, confirm over WhatsApp" flow (see
// PaymentDetailsCard / ContinuePremiumPanel) was replaced with true
// self-service checkout + UPI Autopay recurring subscriptions. WhatsApp is
// kept as a manual fallback in the UI, but from here on the source of truth
// for "is this subscriber currently paid up" is Subscription.status /
// Subscription.currentPeriodEnd, not a human checking a chat thread.
//
// One Subscriber can have more than one Subscription row over time (e.g.
// cancel, then re-subscribe later, or switch billing cycle) — the most
// recent non-CANCELLED/EXPIRED one is the subscriber's active plan.
model Subscription {
  id                     String             @id @default(uuid())
  subscriberId           String
  subscriber             Subscriber         @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  billingCycle           BillingCycle
  provider               String             @default("cashfree")
  // The subscription_id WE generate and send Cashfree when creating the
  // subscription (Cashfree has no separate Plan object to reference —
  // plan_details are sent inline on each create call, see
  // src/lib/cashfree-plans.ts — so unlike a provider-assigned id, this one
  // is ours from the start; Cashfree's own reference number is
  // `cf_subscription_id`, not stored separately here since this id is
  // already enough to look the subscription up via the API if ever needed).
  providerSubscriptionId String             @unique
  status                 SubscriptionStatus @default(CREATED)
  // Set once Cashfree confirms the mandate (SUBSCRIPTION_STATUS_CHANGE webhook /
  // subscription.activated) — null before then.
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  lastPaymentFailedAt    DateTime?
  failureReason          String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  payments               Payment[]

  @@index([subscriberId])
  @@index([status])
}

enum SubscriptionStatus {
  CREATED // subscription object created, checkout not yet completed
  AUTHENTICATED // UPI Autopay mandate authorized, first charge pending
  ACTIVE // at least one successful charge, currently in a paid period
  PENDING // a scheduled charge failed once, Cashfree is retrying
  HALTED // Cashfree stopped retrying after repeated failures (or a customer pause) — treat as lapsed
  CANCELLED // cancelled by subscriber or admin
  COMPLETED // fixed-count plan ran its full course
  EXPIRED // period lapsed with no successful renewal and not formally cancelled
}

// One row per payment attempt (successful or failed) — both the initial
// mandate-authorization charge and every subsequent Autopay renewal charge,
// plus one-off payments if a subscriber ever pays outside a subscription
// (e.g. a manually reconciled WhatsApp/UPI payment an admin logs by hand).
model Payment {
  id                String        @id @default(uuid())
  subscriberId      String
  subscriber        Subscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  provider          String        @default("cashfree")
  // Cashfree's payment_id for this charge. Null for a manually-logged
  // (WhatsApp/UPI) payment an admin enters by hand — see manualEntry below.
  providerPaymentId String?       @unique
  providerOrderId   String?
  amountInPaise     Int
  currency          String        @default("INR")
  status            PaymentStatus
  method            String?
  failureReason     String?
  // True for a payment an admin recorded manually (the WhatsApp fallback
  // path) rather than one that came through a Cashfree webhook.
  manualEntry       Boolean       @default(false)
  createdAt         DateTime      @default(now())

  @@index([subscriberId])
  @@index([subscriptionId])
  @@index([status])
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

// Idempotency log for incoming Cashfree webhook deliveries — Cashfree
// retries a webhook if it doesn't get a 2xx quickly, so the same event can
// arrive more than once. Cashfree doesn't send a dedicated event-id header
// (only `x-webhook-signature` + `x-webhook-timestamp`), so eventId here is
// a SHA-256 hash of `timestamp + rawBody` computed by the webhook handler —
// deterministic per actual delivery, so a retried delivery hashes the same
// and the unique constraint makes it a no-op.
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String   @default("cashfree")
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

// Single-row table (fixed id "singleton") holding site-wide feature toggles
// that used to be hardcoded booleans in src/lib/client-config.ts and needed
// a code change + redeploy to flip. Now editable live from the admin
// Settings page (src/app/admin/(protected)/settings) — see
// src/lib/app-settings.ts for the read/write helpers and caching.
model AppSettings {
  id                   String   @id @default("singleton")
  // Gates the weekly performance digest email cron
  // (src/app/api/cron/weekly-digest/route.ts).
  digestEnabled        Boolean  @default(false)
  // Gates the home-page News & Market Alerts panel (src/app/page.tsx).
  newsAlertsEnabled    Boolean  @default(false)
  // Master switch for broker order-placement from signals. When false,
  // activeBroker is ignored and no broker features render regardless of
  // its value.
  brokerConnectEnabled Boolean  @default(false)
  // Which broker's connect/order-placement flow is live. "dhan" | "goodwill"
  // today; extend with more values as more brokers are wired up. Null when
  // no broker has been chosen yet. At most one broker is ever active at a
  // time — see getActiveBroker() in src/lib/app-settings.ts.
  activeBroker         String?
  updatedAt            DateTime @updatedAt
  // Admin email that made the last change, for a lightweight audit trail.
  updatedBy            String?
}
