// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OptionType {
  CE
  PE
}

enum Instrument {
  NIFTY
  SENSEX
  MIDCAP_NIFTY
  BANK_NIFTY
}

enum SignalStatus {
  OPEN
  TARGET_HIT
  SL_HIT
  CLOSED_MANUAL
}

enum SubscriberPlan {
  PREMIUM
}

model Signal {
  id            String       @id @default(uuid())
  strike        Int
  optionType    OptionType
  instrument    Instrument?
  entryPrice    Float
  stopLoss      Float
  targets       Float[]
  priceAtSignal Float
  sellPrice     Float?
  status        SignalStatus @default(OPEN)
  pnlPercent    Float?
  signalTime    DateTime     @default(now())
  closedTime    DateTime?
  rawMessage    String
  adminNote     String?
  // Set by the Manage Signals edit form so the realtime listener can tell
  // "admin corrected a field" apart from a genuine new/closed signal and
  // skip the sound alert for it (still refreshes page content either way).
  silentUpdateAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([signalTime])
  @@index([status])
}

model Subscriber {
  id        String         @id @default(uuid())
  name      String
  phone     String
  email     String?
  plan      SubscriberPlan @default(PREMIUM)
  createdAt DateTime       @default(now())
}

model Referral {
  id            String   @id @default(uuid())
  referrerName  String
  referrerPhone String
  referredName  String
  referredPhone String
  createdAt     DateTime @default(now())

  @@index([referrerPhone])
}
